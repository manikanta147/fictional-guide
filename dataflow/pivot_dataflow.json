{
	"name": "pivot_dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText3",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "output_param",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "pivot1"
				},
				{
					"name": "MapDrifted1",
					"description": "Creates an explicit mapping for each drifted column"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as integer,",
				"          name as string,",
				"          subjects as string,",
				"          marks as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 pivot(groupBy(id,",
				"          name),",
				"     pivotBy(subjects),",
				"     {} = min(marks),",
				"     columnNaming: '$N$V',",
				"     lateral: true) ~> pivot1",
				"pivot1 derive(telugu = toInteger(byName('telugu')),",
				"          hindi = toInteger(byName('hindi')),",
				"          english = toInteger(byName('english')),",
				"          maths = toInteger(byName('maths')),",
				"          science = toInteger(byName('science')),",
				"          social = toInteger(byName('social')),",
				"          chemistry = toInteger(byName('chemistry'))) ~> MapDrifted1",
				"MapDrifted1 select(mapColumn(",
				"          id,",
				"          name,",
				"          telugu,",
				"          hindi,",
				"          english,",
				"          maths,",
				"          science,",
				"          social,",
				"          chemistry",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id as string,",
				"          type as string,",
				"          name as string,",
				"          ppu as string,",
				"          {batter.id} as string,",
				"          {batter.type} as string,",
				"          {topping.id} as string,",
				"          {topping.nam} as string",
				"     ),",
				"     partitionFileNames:['unpivot.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}